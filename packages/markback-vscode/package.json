{
  "name": "markback-vscode",
  "displayName": "Markback",
  "description": "Review Markdown like a doc — comment on the preview (and any file) with feedback saved to a plain-text .mb sidecar that diffs in git.",
  "version": "0.3.6",
  "publisher": "dandriscoll",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#222b3a",
    "theme": "dark"
  },
  "homepage": "https://markback.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/dandriscoll/markback.git",
    "directory": "packages/markback-vscode"
  },
  "bugs": {
    "url": "https://github.com/dandriscoll/markback/issues"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "comments",
    "annotation",
    "review",
    "feedback",
    "markback",
    "sidecar",
    "docs",
    "notes"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markback.commentSelection",
        "title": "Comment on Selection",
        "category": "Markback"
      },
      {
        "command": "markback.saveComment",
        "title": "Save Comment",
        "category": "Markback",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "markback.cancelDraft",
        "title": "Cancel",
        "category": "Markback"
      },
      {
        "command": "markback.showOutput",
        "title": "Show Output Log",
        "category": "Markback"
      },
      {
        "command": "markback.openSidecar",
        "title": "Open Sidecar",
        "category": "Markback",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markback.previewComment",
        "title": "Add Comment from Preview",
        "category": "Markback",
        "enablement": "false"
      },
      {
        "command": "markback.previewOpenSidecar",
        "title": "Open Sidecar from Preview",
        "category": "Markback",
        "enablement": "false"
      },
      {
        "command": "markback.previewReply",
        "title": "Reply from Preview",
        "category": "Markback",
        "enablement": "false"
      },
      {
        "command": "markback.editComment",
        "title": "Edit Comment",
        "category": "Markback",
        "icon": "$(edit)"
      },
      {
        "command": "markback.deleteComment",
        "title": "Delete Comment",
        "category": "Markback",
        "icon": "$(trash)"
      },
      {
        "command": "markback.saveEditComment",
        "title": "Save",
        "category": "Markback"
      },
      {
        "command": "markback.cancelEditComment",
        "title": "Cancel",
        "category": "Markback"
      },
      {
        "command": "markback.discardCommentWithConfirm",
        "title": "Discard Comment",
        "category": "Markback"
      },
      {
        "command": "markback.resolveComment",
        "title": "Resolve",
        "category": "Markback"
      },
      {
        "command": "markback.reopenComment",
        "title": "Reopen",
        "category": "Markback"
      }
    ],
    "keybindings": [
      {
        "command": "markback.commentSelection",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus"
      },
      {
        "command": "markback.discardCommentWithConfirm",
        "key": "escape",
        "when": "commentEditorFocused && commentController == markback && !commentIsEmpty"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markback.commentSelection",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markback.saveComment",
          "when": "false"
        },
        {
          "command": "markback.cancelDraft",
          "when": "false"
        },
        {
          "command": "markback.previewComment",
          "when": "false"
        },
        {
          "command": "markback.previewOpenSidecar",
          "when": "false"
        },
        {
          "command": "markback.previewReply",
          "when": "false"
        },
        {
          "command": "markback.editComment",
          "when": "false"
        },
        {
          "command": "markback.deleteComment",
          "when": "false"
        },
        {
          "command": "markback.saveEditComment",
          "when": "false"
        },
        {
          "command": "markback.cancelEditComment",
          "when": "false"
        },
        {
          "command": "markback.discardCommentWithConfirm",
          "when": "false"
        },
        {
          "command": "markback.resolveComment",
          "when": "false"
        },
        {
          "command": "markback.reopenComment",
          "when": "false"
        }
      ],
      "comments/comment/title": [
        {
          "command": "markback.editComment",
          "group": "inline@1",
          "when": "commentController == markback"
        },
        {
          "command": "markback.deleteComment",
          "group": "inline@2",
          "when": "commentController == markback"
        }
      ],
      "comments/comment/context": [
        {
          "command": "markback.saveEditComment",
          "group": "inline@1",
          "when": "commentController == markback"
        },
        {
          "command": "markback.cancelEditComment",
          "group": "inline@2",
          "when": "commentController == markback"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "markback.saveComment",
          "group": "inline@1",
          "when": "commentController == markback && commentThreadIsEmpty"
        },
        {
          "command": "markback.cancelDraft",
          "group": "inline@2",
          "when": "commentController == markback && commentThreadIsEmpty"
        },
        {
          "command": "markback.saveComment",
          "group": "inline@1",
          "when": "commentController == markback && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "markback.openSidecar",
          "group": "inline",
          "when": "commentController == markback && !commentThreadIsEmpty"
        },
        {
          "command": "markback.resolveComment",
          "group": "inline",
          "when": "commentController == markback && commentThread == markback.persisted.unresolved"
        },
        {
          "command": "markback.reopenComment",
          "group": "inline",
          "when": "commentController == markback && commentThread == markback.persisted.resolved"
        }
      ]
    },
    "configuration": {
      "title": "Markback",
      "properties": {
        "markback.author": {
          "type": "string",
          "default": "",
          "description": "Identifier written as @by on every comment. If empty, falls back to `git config user.email`, then to no @by header."
        },
        "markback.inlineExcerpt.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Embed the literal selected source text as inline content in the generated .mb record when the selection is small enough (see maxLines/maxChars). Disable to always write a compact, range-only record."
        },
        "markback.inlineExcerpt.maxLines": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Maximum number of lines a selection may span to be embedded inline. Larger selections are recorded range-only. To turn embedding off entirely, set markback.inlineExcerpt.enabled to false."
        },
        "markback.inlineExcerpt.maxChars": {
          "type": "number",
          "default": 600,
          "minimum": 1,
          "description": "Maximum number of characters a selection may contain to be embedded inline. Larger selections are recorded range-only. To turn embedding off entirely, set markback.inlineExcerpt.enabled to false."
        }
      }
    },
    "markdown.previewScripts": [
      "./src/preview/inject.js"
    ],
    "markdown.previewStyles": [
      "./src/preview/inject.css"
    ],
    "markdown.markdownItPlugins": true
  },
  "scripts": {
    "vscode:prepublish": "npm run build:dep && npm run clean && npm run bundle",
    "build:dep": "npm --prefix ../markbackjs run build",
    "bundle": "node esbuild.js",
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretest": "npm run compile",
    "test": "node --test test/*.test.js",
    "pretest:integration": "npm run compile",
    "test:integration": "node test-integration/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "glob": "^11.1.0",
    "https-proxy-agent": "^7.0.6",
    "jsdom": "^26.1.0",
    "markbackjs": "file:../markbackjs",
    "markdown-it": "^15.0.3",
    "mocha": "^10.8.2",
    "typescript": "^5.4.0"
  }
}
